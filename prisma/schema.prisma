datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  bio       String? 
    avatarData String?
  memories  Memory[]
  createdAt DateTime @default(now())
}

model Memory {
  id          String   @id @default(uuid())
  title       String
  description String
  date        String
  tags        String   
  imageData   String   
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}